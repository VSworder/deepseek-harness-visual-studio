<Project>

  <!--
    Shared build settings for every project in this repository.

    Visual Studio is not always on the system drive. We resolve it with vswhere, which
    ships with the VS Installer and is the supported way to locate an installation, and
    fall back to the conventional path. Override on the command line when needed:

        msbuild /p:VsInstallRoot="D:\VisualStudio"
  -->
  <PropertyGroup>
    <VswherePath Condition="'$(VswherePath)' == ''">$(ProgramFiles)\Microsoft Visual Studio\Installer\vswhere.exe</VswherePath>
    <VswherePath Condition="!Exists('$(VswherePath)')">$(ProgramFiles(x86))\Microsoft Visual Studio\Installer\vswhere.exe</VswherePath>

    <VsInstallRoot Condition="'$(VsInstallRoot)' == '' AND Exists('$(VswherePath)')">$([System.Diagnostics.Process]::Start(&quot;$(VswherePath)&quot;, &quot;-latest -products * -property installationPath&quot;).StandardOutput.ReadToEnd().Trim())</VsInstallRoot>
    <!-- No guessed fallback. Baking in a year, an edition and the system drive produced
         unresolved HintPath errors instead of "Visual Studio not found", and it shipped one
         machine's layout in the source. The check itself is a target below, because an Error
         element is not valid directly inside a props file. -->
    <VsInstallRootLooksValid Condition="Exists('$(VsInstallRoot)\Common7\IDE\devenv.exe')">true</VsInstallRootLooksValid>

    <!-- PublicAssemblies carries the interop and shell contracts this extension compiles against. -->
    <VsPublicAssemblies>$(VsInstallRoot)\Common7\IDE\PublicAssemblies</VsPublicAssemblies>
    <VsPrivateAssemblies>$(VsInstallRoot)\Common7\IDE\PrivateAssemblies</VsPrivateAssemblies>
    <!-- Microsoft.VisualStudio.Threading is not in PublicAssemblies. The copy under
         the VSSDK build folder is the .NET Framework build (it does not reference the
         System.Runtime facade), unlike the 18.7 copy under VBCSharp which targets .NET 8
         and cannot be referenced from a net48 extension. -->
    <!-- Visual Studio's terminal host contract (ConPTY-backed). Used to start a
         DeepSeek Harness session in a real VS terminal tab. -->
    <VsTerminalAssembly>$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\Terminal\Microsoft.VisualStudio.Terminal.dll</VsTerminalAssembly>
    <!-- The "v18.0" segment is the VS major version. It follows $(VisualStudioVersion) so a
         build on VS 2022 looks in v17.0 instead of failing to resolve the reference. -->
    <VsSdkVersionFolder Condition="'$(VsSdkVersionFolder)' == '' AND '$(VisualStudioVersion)' != ''">v$(VisualStudioVersion)</VsSdkVersionFolder>
    <VsSdkVersionFolder Condition="'$(VsSdkVersionFolder)' == ''">v18.0</VsSdkVersionFolder>
    <VsThreadingAssembly>$(VsInstallRoot)\MSBuild\Microsoft\VisualStudio\$(VsSdkVersionFolder)\VSSDK\Microsoft.VisualStudio.Threading.dll</VsThreadingAssembly>
  </PropertyGroup>

  <!-- One target framework for every project, matching the VS 2026 VSIX project
       template. Keep them in step: the packaging project must be able to reference
       the product assemblies. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- Keep intermediate output out of the source tree where possible. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Fails with a readable message instead of a pile of unresolved HintPath errors when
       Visual Studio could not be located. -->
  <Target Name="VerifyVsInstallRoot" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="'$(VsInstallRootLooksValid)' != 'true'"
           Text="Visual Studio not found (looked for devenv.exe under '$(VsInstallRoot)'). Install vswhere - it ships with the Visual Studio Installer - or pass /p:VsInstallRoot=&lt;path&gt;." />
  </Target>

</Project>
