{
  "name": "@deepseek-harness-vs/dsh-plugin-vs-gate",
  "version": "0.2.2",
  "description": "Route DeepSeek Harness file edits to Visual Studio's native diff window and let the verdict decide whether the write happens.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VSworder/deepseek-harness-visual-studio.git",
    "directory": "packages/dsh-plugin-vs-gate"
  },
  "homepage": "https://github.com/VSworder/deepseek-harness-visual-studio#readme",
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "visual-studio",
    "diff",
    "approval"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  }
}
